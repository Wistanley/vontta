# Copie para worker/.env.radar e mantenha fora do Git. Use as mesmas credenciais
# de servidor e chave de cifragem do Vontta para abrir as conexões existentes.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
AI_SETTINGS_ENCRYPTION_KEY=
RADAR_OWNER_ID=
# Gere um segredo aleatório de 32 bytes. A credencial Header Auth do n8n usa
# Authorization: Bearer <segredo>. Nunca copie esse valor para o workflow JSON.
RADAR_INTERNAL_TOKEN=
