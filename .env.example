VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Somente no servidor. Escolha um provedor e um modelo disponível na sua conta.
AI_PROVIDER=openai
AI_MODEL=
AI_MODEL_OPENAI=
AI_MODEL_ANTHROPIC=
AI_MODEL_GOOGLE=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
GOOGLE_GENERATIVE_AI_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 32 bytes em hexadecimal. Cifra credenciais de IA e Pluggy no servidor; mantenha estável entre deploys.
AI_SETTINGS_ENCRYPTION_KEY=
# Automação de posts, somente no servidor. Agendador externo chama /api/post-worker
# a cada minuto com Authorization: Bearer CRON_SECRET. Não use prefixo VITE_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
